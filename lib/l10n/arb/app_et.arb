 "s3a38b97f7b": "{p0} – ruum",
 "@s3a38b97f7b": {
  "x-mt": true
 },
 "s2a3f705876": "Ladustuspõrandaküte (betoon)",
 "@s2a3f705876": {
  "x-mt": true
 },
 "se02b21f2e5": "Betoonplaat salvestab soojust pikka aega: küte viiakse kõige odavamatele tundidele ja tundide arv järgib prognoosi.",
 "@se02b21f2e5": {
  "x-mt": true
 },
 "sed77dcfc1a": "Kerge põrandaküte",
 "@sed77dcfc1a": {
  "x-mt": true
 },
 "s4699e792b9": "Kerge põrand hoiab vähe soojust: kõige kallimad tunnid jäetakse vahele, ainult lühikeste vaheaegadega.",
 "@s4699e792b9": {
  "x-mt": true
 },
 "s5d46662c4e": "Otsesed elektriradiaatorid",
 "@s5d46662c4e": {
  "x-mt": true
 },
 "s12e9bbf847": "Radiaatorid ei salvesta soojust: vahele jäetakse ainult kõige kallimad tunnid, üks tund korraga.",
 "@s12e9bbf847": {
  "x-mt": true
 },
 "s1c0bf9b38b": "Õhksoojuspump",
 "@s1c0bf9b38b": {
  "x-mt": true
 },
 "s6896be80e0": "Soojuspump töötab kõige paremini ühtlasel temperatuuril: sihtmärk tõuseb veidi enne kallist või külma loitsu ja langeb kallitel tundidel.",
 "@s6896be80e0": {
  "x-mt": true
 },
 "s765f87536c": "Maasoojuspump",
 "@s765f87536c": {
  "x-mt": true
 },
 "s33536024e7": "Maapealne soojus koos veeringlusega talletab veidi soojust: kõige kallimad tunnid jäetakse vahele kõige rohkem mõnetunniste vaheaegadega.",
 "@s33536024e7": {
  "x-mt": true
 },
 "s3a7d2e6848": "Veesoojendi",
 "@s3a7d2e6848": {
  "x-mt": true
 },
 "s4eec9a0479": "Veesoojendi püsib kuumana päevaks: seda soojendatakse kõige odavamatel tundidel päevas.",
 "@s4eec9a0479": {
  "x-mt": true
 },
 "sa2dc343545": "Kaminarežiim lõppes: ruum jahtub. Kütmine on taas normaalne.",
 "@sa2dc343545": {
