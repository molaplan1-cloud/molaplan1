  "x-mt": true
 },
 "s9efd151ae8": "En el comando",
 "@s9efd151ae8": {
  "x-mt": true
 },
 "s29d460cd3b": "'{key} = la llave del interruptor. E.g. \"{key} on\" → \"light on\".'",
