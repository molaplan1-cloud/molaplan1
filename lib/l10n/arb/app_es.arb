 "@s0f7533967d": {
  "x-mt": true
 },
 "s2e60dd8178": "Gire \"Remote control\" en.",
 "@s2e60dd8178": {
  "x-mt": true
 },
 "s7a73024451": "Copiar la dirección remota, que parece: https://abcd1234.ui.nabu.casa",
 "@s7a73024451": {
  "x-mt": true
 },
